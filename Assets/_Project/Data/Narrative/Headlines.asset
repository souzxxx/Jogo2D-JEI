%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b01ea169d0efc47059cb2c79e2944491, type: 3}
  m_Name: Headlines
  m_EditorClassIdentifier: AFirma.Core::AFirma.Core.HeadlineSetDef
  clean:
  - '{golpe}: QUADRILHA LEVA {valor} SEM DEIXAR RASTRO'
  - 'MISTÉRIO EM NOVA GUANABARA: SOMEM {valor} E NINGUÉM VIU NADA'
  - '{golpe}: VIGIA JURA QUE "TAVA TUDO NORMAL"; SUMIRAM {valor}'
  - '{bastos} SOBRE O CASO {golpe}: "{fala}"'
  - 'FIRMA FANTASMA ATACA DE NOVO: {valor} EVAPORAM NA MADRUGADA'
  hasty:
  - 'FUGA ÀS PRESSAS! BANDO ESCAPA COM {valor} ANTES DA POLÍCIA CHEGAR'
  - '{golpe}: SIRENE TOCA, BANDO CORRE E AINDA LEVA {valor}'
  - 'POR UM TRIZ: VIATURA CHEGA E SÓ ACHA A PORTA ABERTA'
  - '{bastos} CHEGA ATRASADO: "O TRÂNSITO TAVA UM HORROR"'
  forced:
  - '{golpe}: POLÍCIA CHEGA E BANDO FOGE DEIXANDO DINHEIRO PRA TRÁS'
  - 'SUFOCO NA MADRUGADA: QUADRILHA FOGE E ESPALHA NOTA PELA CALÇADA'
  - '{bastos} QUASE PEGA A FIRMA: "FOI POR UM FIO DE BIGODE"'
  - '{golpe}: BANDO ESCAPA, MAS A SACOLA VOLTA PELA METADE'
  perfect:
  - 'CAVALO DE PAU HISTÓRICO: VAN SOME COM {valor} NA FRENTE DA POLÍCIA'
  - '{golpe}: KOMBI DÁ CAVALO DE PAU E DEIXA VIATURA RODANDO NA PRAÇA'
  - '{bastos} SOBRE A FUGA: "NINGUÉM FAZ CURVA ASSIM, ISSO É TRUQUE"'
  - 'MOTORISTA FANTASMA: FIRMA SOME COM {valor} E A POLÍCIA SÓ VÊ A POEIRA'
  withArrests:
  - '{bastos} PRENDE INTEGRANTE DE QUADRILHA: "É SÓ O COMEÇO"'
  - '{golpe}: UM DO BANDO VAI EM CANA, O RESTO SOME COM {valor}'
  - '{bastos} POSA PRA FOTO COM O PRESO: "{fala}"'
  - 'CANA! FIRMA PERDE UM DOS SEUS, MAS O DINHEIRO NÃO APARECE'
  interrupted:
  - '{golpe}: QUADRILHA ABANDONA O SERVIÇO PELA METADE E SOME'
  - 'GOLPE PELA METADE: BANDO SAI DE FININHO COM {valor}'
  - '{golpe}: VIZINHO OUVE BARULHO, MAS QUANDO OLHA NÃO TEM NINGUÉM'
  byHeist:
  - heist: {fileID: 11400000, guid: 42e1ab2969eb241aeb1dd04713e920c4, type: 2}
    completed:
    - 'SEU ZÉ JURA QUE O BILHETE PREMIADO TAVA NO COFRE'
    - 'LOTÉRICA AMANHECE SEM TROCO; SEU ZÉ: "NEM A FEZINHA ESCAPOU"'
  - heist: {fileID: 11400000, guid: 3540c87700a5d479aad0bb378967e3da, type: 2}
    completed:
    - 'BRILHO ETERNO PERDE O BRILHO: VITRINE AMANHECE VAZIA'
    - '{golpe}: ALARME NOVINHO NEM PISCOU'
  - heist: {fileID: 11400000, guid: e7fe8f60b2cd9444e93638b1468af13f, type: 2}
    completed:
    - 'DÓLAR FÁCIL, SAÍDA MAIS FÁCIL AINDA: SOMEM {valor} DO CÂMBIO'
    - 'DONO DO CÂMBIO NUNCA CONFIOU EM BANCO; AGORA NÃO CONFIA EM NINGUÉM'
  - heist: {fileID: 11400000, guid: ee5e41db40494413795657b7615b49a5, type: 2}
    completed:
    - 'PASTELARIA ABRE NORMAL; JÁ O CASSINO DO PORÃO AMANHECE LIMPO'
    - '{golpe}: A BANCA SEMPRE GANHA, MENOS ONTEM'
  - heist: {fileID: 11400000, guid: d565e6b102b3740f9a7b4e04215dd7e7, type: 2}
    completed:
    - 'O GOLPE DO SÉCULO VIROU ROTINA: TÚNEL LEVA {valor} DO BANCO CENTRAL'
    - 'BANCO CENTRAL DE NOVO! {bastos}: "{fala}"'
  bastos:
  - title: DELEGADO BASTOS
    quotes:
    - 'É QUESTÃO DE DIAS'
    - 'JÁ PEGUEI ESSA FIRMA UMA VEZ, PEGO DE NOVO'
    - 'TÔ NO RASTRO, SÓ NÃO POSSO DIZER DE QUEM'
  - title: SUPERINTENDENTE BASTOS
    quotes:
    - 'PROMOÇÃO NÃO ME FEZ ESQUECER DE VOCÊS'
    - 'AGORA TENHO VIATURA NOVA E PACIÊNCIA NENHUMA'
    - 'É QUESTÃO DE DIAS. ÚTEIS'
  - title: SECRETÁRIO BASTOS
    quotes:
    - 'A CIDADE INTEIRA TÁ DE OLHO'
    - 'PEDI VERBA PRA MAIS DEZ VIATURAS'
    - 'ESSA FIRMA VIROU QUESTÃO PESSOAL'
