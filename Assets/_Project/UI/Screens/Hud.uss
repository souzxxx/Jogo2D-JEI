/* HUD do golpe: caixas escuras nas bordas pra não tampar a cena do Miguel, popups de papel no meio. */

.hud {
    padding: 6px;
}

.hud__top {
    align-items: flex-start;
}

.hud__top > * {
    margin-right: 4px;
}

.hud__room {
    width: 150px;
}

.hud__alert {
    width: 170px;
}

.hud__bag Label {
    margin-right: 6px;
}

.hud__money {
    color: var(--mint);
}

.hud__small {
    min-width: 28px;
    margin: 0 0 0 4px;
    white-space: nowrap; /* "2x" quebrava em duas linhas */
}

.bar {
    height: 6px;
    margin-top: 2px;
    background-color: var(--night);
    border-width: 1px;
    border-color: var(--slate);
}

.bar__fill {
    height: 100%;
    width: 0;
    background-color: var(--money);
}

.bar__fill--room {
    background-color: var(--cyan);
}

.alert--mid {
    background-color: var(--gold);
}

.alert--high {
    background-color: var(--red);
}

/* caixa escura como as outras da HUD: por cima de letreiro da cena (a placa da rua na abertura) continua legível */
.hud__countdown {
    align-self: center;
    margin-top: 8px;
    padding: 0 8px;
    color: var(--red);
    background-color: rgba(14, 12, 21, 0.86);
    border-width: 1px;
    border-color: var(--slate);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
}

.hud__bottom {
    align-items: flex-end;
}

/* ladrão na HUD: retrato cortado no rosto e o botão da habilidade */
.hud-thief {
    width: 128px;
    margin-right: 4px;
}

.hud-thief__face {
    width: 40px;
    height: 40px;
    margin-right: 4px;
    background-size: 64px 64px;
    background-position-x: center;
    background-position-y: center;
    border-width: 1px;
    border-color: var(--slate);
}

.hud-thief .btn {
    font-size: 11px;
    padding: 1px 3px;
    min-height: 14px;
}

.hud__flee {
    padding: 4px 12px;
}

/* right maior que left: o bip da Dona Cida (pager, 170 px no canto direito) não encosta na janela.
   Com a sirene tocando, a HeistHud desce a janela pra baixo da contagem da polícia. */
.hud__popup {
    position: absolute;
    left: 170px;
    right: 180px;
    top: 70px;
}

.event__art {
    height: 64px;
    margin: 4px 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* ícones de obstáculo da Cena do Golpe (Miguel) */
.icon--0 {
    background-image: url("../../HeistScene/Art/Icones/Icone_Fechadura.png");
}

.icon--1 {
    background-image: url("../../HeistScene/Art/Icones/Icone_Sistema.png");
}

.icon--2 {
    background-image: url("../../HeistScene/Art/Icones/Icone_Pessoa.png");
}

.icon--nospec {
    background-image: url("../../HeistScene/Art/Icones/Icone_SemEspecialista.png");
}

/* ---------------------------------------------------------------- jornal */

.news {
    width: 420px;
    background-color: var(--cream);
    border-width: 1px;
    border-color: var(--umber);
    padding: 10px 12px;
    rotate: -2deg;
    transition-property: rotate, scale;
    transition-duration: 0.7s;
    transition-timing-function: ease-out-back;
}

.news--folded {
    rotate: 700deg;
    scale: 0.1 0.1;
}

.news__mast {
    -unity-text-align: middle-center;
    color: var(--ink);
}

.news__rule {
    height: 2px;
    background-color: var(--ink);
    margin: 3px 0;
}

.news__headline {
    color: var(--ink);
    margin: 4px 0 6px 0;
}

.news__col {
    flex-grow: 1;
    flex-basis: 0;
    align-items: stretch;
}

.news__thief {
    margin-bottom: 3px;
}

/* capa da revanche: borda dupla vermelha */
.news--special {
    border-width: 3px;
    border-color: var(--red);
}

/* foto da capa da abertura (Bastos com a firma algemada, 64x44) */
.news__photo {
    width: 128px;
    height: 88px;
    flex-shrink: 0;
    margin-right: 8px;
    border-width: 1px;
    border-color: var(--ink);
}

.news__sub {
    color: var(--ink);
    white-space: normal;
}

/* ---------------------------------------------------------------- abertura */

/* letreiro: tela preta com o texto batendo à máquina */
.intro {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--ink);
    align-items: center;
    justify-content: center;
}

.intro__text {
    color: var(--cream);
    max-width: 480px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* em cima do Meter o pé */
.hud__skip {
    position: absolute;
    right: 8px;
    bottom: 44px;
}

/* avisos no canto de baixo, em cima dos cartões da crew: no meio da tela eles caíam em cima dos balões da cena */
.hud .toasts {
    bottom: 64px;
    left: 6px;
    right: auto;
    align-items: flex-start;
}

.hud .toast {
    max-width: 240px;
}
