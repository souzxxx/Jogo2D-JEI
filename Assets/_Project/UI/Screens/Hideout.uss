/* Esconderijo: o porão da Auto Elétrica da Cida (Art/Esconderijo.png) com as abas da pasta à esquerda. */

.hideout {
    background-image: url("../Art/Esconderijo.png");
}

.hideout__top {
    height: 28px;
    padding: 0 8px;
}

.hideout__top Label {
    margin-right: 8px;
}

.hideout__money {
    color: var(--mint);
}

.hideout__body {
    flex-grow: 1;
    align-items: stretch;
    padding: 6px 8px 8px 0;
}

.hideout__tabs {
    width: 96px;
    padding-top: 6px;
}

.hideout__content {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- aba Mapa */

.map {
    width: 400px;
    height: 230px;
    flex-shrink: 0;
    align-self: center;
    background-image: url("../Art/Mapa.png");
}

/* pino: ponto no lugar do golpe e a etiqueta embaixo */
.pin,
.pin:hover,
.pin:active,
.pin:focus {
    position: absolute;
    translate: -50% -4px;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    margin: 0;
}

.pin__dot {
    width: 8px;
    height: 8px;
    background-color: var(--red);
    border-width: 1px;
    border-color: var(--umber);
}

.pin__name {
    background-color: var(--cream);
    border-width: 1px;
    border-color: var(--umber);
    padding: 0 3px;
    max-width: 112px;
    -unity-text-align: middle-center;
}

.pin__mod {
    background-color: var(--wine);
    color: var(--cream);
    padding: 0 3px;
    white-space: nowrap;
}

.pin--locked .pin__dot {
    background-color: var(--steel);
}

.pin--locked .pin__name {
    background-color: var(--pale);
    color: var(--steel);
}

.pin--done .pin__dot {
    background-color: var(--money);
}

.pin:hover .pin__name,
.pin--on .pin__name {
    background-color: var(--lamp);
    color: var(--umber);
}

.map__info {
    margin-top: 4px;
    align-items: flex-end;
}

/* ---------------------------------------------------------------- planejamento */

.plan {
    flex-grow: 1;
    align-items: stretch;
    margin: 4px 0;
}

.plan__brief {
    width: 210px;
    margin-right: 6px;
}

.plan__crew {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- aba Bicos: a vitrine (cena 96x64) */

.showcase {
    width: 96px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 6px;
    border-width: 1px;
    border-color: var(--umber);
}

.showcase--empty {
    -unity-background-image-tint-color: rgb(120, 120, 140);
}

.showcase__name {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: 94px;
    padding: 0 2px;
    color: var(--cream);
    background-color: rgba(14, 12, 21, 0.8);
}

.showcase__sign {
    position: absolute;
    left: 18px;
    top: 24px;
    padding: 0 3px;
    color: var(--umber);
    background-color: var(--kraft);
    border-width: 1px;
    border-color: var(--wood);
}

/* ---------------------------------------------------------------- abas Crew e Contatos */

.crew__actions {
    width: 112px;
    flex-shrink: 0;
    justify-content: center;
}
