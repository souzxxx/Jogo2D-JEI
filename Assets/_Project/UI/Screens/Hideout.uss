/* Esconderijo: o porão da Auto Elétrica da Cida (Art/Esconderijo.png) com as abas da pasta à esquerda. */

.hideout {
    background-image: url("../Art/Esconderijo.png");
}

.hideout__top {
    height: 28px;
    padding: 0 8px;
}

.hideout__top Label {
    margin-right: 8px;
}

.hideout__money {
    color: var(--mint);
}

/* "Objetivo: Banco Central" e a escada de golpes até lá */
.hideout__objective,
.hideout__objective:hover,
.hideout__objective:active,
.hideout__objective:focus {
    align-items: center;
    margin: 0 0 0 4px;
    padding: 0 4px;
    border-radius: 0;
    border-width: 1px;
    border-color: var(--bronze);
    background-color: rgba(0, 0, 0, 0);
}

.hideout__objective:hover {
    border-color: var(--lamp);
}

.hideout__objective Label {
    color: var(--lamp);
    margin-right: 3px;
}

.objective__step {
    width: 6px;
    height: 6px;
    margin-left: 2px;
    background-color: var(--slate);
}

.objective__step--done {
    background-color: var(--money);
}

.objective__step--next {
    background-color: var(--lamp);
}

.hideout__body {
    flex-grow: 1;
    align-items: stretch;
    padding: 6px 8px 8px 0;
}

.hideout__tabs {
    width: 96px;
    padding-top: 6px;
}

.hideout__content {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- aba Mapa */

.map {
    width: 400px;
    height: 230px;
    flex-shrink: 0;
    align-self: center;
    background-image: url("../Art/Mapa.png");
}

/* pino: ponto no lugar do golpe e a etiqueta embaixo */
.pin,
.pin:hover,
.pin:active,
.pin:focus {
    position: absolute;
    translate: -50% -4px;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    margin: 0;
}

.pin__dot {
    width: 8px;
    height: 8px;
    background-color: var(--red);
    border-width: 1px;
    border-color: var(--umber);
}

.pin__name {
    background-color: var(--cream);
    border-width: 1px;
    border-color: var(--umber);
    padding: 0 3px;
    max-width: 112px;
    -unity-text-align: middle-center;
}

.pin__mod {
    background-color: var(--wine);
    color: var(--cream);
    padding: 0 3px;
    white-space: nowrap;
}

.pin--locked .pin__dot {
    background-color: var(--steel);
}

.pin--locked .pin__name {
    background-color: var(--pale);
    color: var(--steel);
}

.pin--done .pin__dot {
    background-color: var(--money);
}

.pin:hover .pin__name,
.pin--on .pin__name {
    background-color: var(--lamp);
    color: var(--umber);
}

.map__info {
    margin-top: 4px;
    align-items: flex-end;
}

/* ---------------------------------------------------------------- planejamento */

.plan {
    flex-grow: 1;
    align-items: stretch;
    margin: 4px 0;
}

.plan__brief {
    width: 210px;
    margin-right: 6px;
}

.plan__crew {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- faixa Golpes rolando (embaixo das abas) */

.auto {
    margin-top: 6px;
}

.auto__head {
    padding: 0 2px;
    background-color: rgba(14, 12, 21, 0.86);
}

.auto__empty {
    white-space: normal;
    padding: 2px;
    color: var(--tan);
}

.auto__card,
.auto__card:hover,
.auto__card:active,
.auto__card:focus {
    margin: 2px 0 0 0;
    padding: 2px;
    border-radius: 0;
    border-width: 1px;
    border-color: var(--slate);
    background-color: rgba(14, 12, 21, 0.86);
    align-items: stretch;
}

.auto__card:hover {
    border-color: var(--lamp);
}

.auto__card--red {
    border-color: var(--red);
}

.auto__card--blue {
    border-color: var(--blue);
}

.auto__thumb {
    width: 32px;
    height: 24px;
    flex-shrink: 0;
    margin-right: 2px;
    background-size: 32px 24px;
    align-items: center;
    justify-content: center;
}

.auto__bag {
    color: var(--mint);
    white-space: nowrap;
    overflow: hidden;
}

.auto__bar {
    height: 3px;
    margin: 1px 0 2px 0;
    background-color: var(--night);
}

.auto__fill {
    height: 100%;
    background-color: var(--gold);
}

.auto__fill--high {
    background-color: var(--red);
}

.auto__face {
    width: 14px;
    height: 14px;
    margin-right: 1px;
    background-size: 22px 22px;
    background-position-x: center;
    background-position-y: center;
    border-width: 1px;
    border-color: var(--slate);
}

.auto__dots {
    margin-top: 2px;
    flex-wrap: wrap;
}

.auto__dot {
    width: 4px;
    height: 4px;
    margin: 0 1px 1px 0;
    background-color: var(--steel);
}

.auto__dot--done {
    background-color: var(--money);
}

.auto__dot--now {
    background-color: var(--lamp);
}

.auto__jail {
    position: absolute;
    left: 2px;
    top: 8px;
    rotate: -6deg;
}

/* mini capa do jornal ao lado do cartão no fim de cada volta */
.auto__news {
    position: absolute;
    left: 102px;
    width: 210px;
    padding: 3px 5px;
    color: var(--ink);
    background-color: var(--paper);
    border-width: 1px;
    border-color: var(--umber);
    transition: opacity 0.4s;
}

.auto__mast {
    color: var(--wine);
    border-bottom-width: 1px;
    border-color: var(--umber);
    margin-bottom: 2px;
}

.auto__fly {
    position: absolute;
    color: var(--mint);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
    transition: translate 0.8s ease-in;
}

/* ---------------------------------------------------------------- aba Bicos: a vitrine (cena 96x64) */

.showcase {
    width: 96px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 6px;
    border-width: 1px;
    border-color: var(--umber);
}

.showcase--empty {
    -unity-background-image-tint-color: rgb(120, 120, 140);
}

.showcase__name {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: 94px;
    padding: 0 2px;
    color: var(--cream);
    background-color: rgba(14, 12, 21, 0.8);
}

.showcase__sign {
    position: absolute;
    left: 18px;
    top: 24px;
    padding: 0 3px;
    color: var(--umber);
    background-color: var(--kraft);
    border-width: 1px;
    border-color: var(--wood);
}

/* ---------------------------------------------------------------- abas Crew e Contatos */

.crew__actions {
    width: 112px;
    flex-shrink: 0;
    justify-content: center;
}
